{
    "dataRoles": [
        {
            "displayName": "Rows",
            "name": "rows",
            "kind": "Grouping",
            "description": "The dimensions that define each row of the table."
        },
        {
            "displayName": "Values",
            "name": "values",
            "kind": "Measure",
            "description": "The metrics or columns to display."
        },
        {
            "displayName": "Group by",
            "name": "groupBy",
            "kind": "Grouping",
            "description": "Optional field(s) to group and drill into rows. Multiple fields create nested groups."
        },
        {
            "displayName": "Tooltips",
            "name": "tooltips",
            "kind": "Grouping",
            "description": "Optional fields shown only when hovering a row."
        },
        {
            "displayName": "Permissions",
            "name": "permissions",
            "kind": "Measure",
            "description": "Optional: bind a DAX measure (e.g. built on USERPRINCIPALNAME()/USERNAME() looked up against a permissions table) returning a text access value for the current viewer, such as \"no-export\", \"read-only\", or \"no-premium\" (ASSUMED tier value added for Item 26 -- gates Link Actions + Conditional Formatting; see docs/LICENSING_NOTES.md and src/tierGating.ts; confirm the exact value/feature set with the product owner before shipping). Leave unbound for full functionality for everyone. This is a UI-level control in the visual, not a substitute for Row-Level Security."
        }
    ],
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "rows" } },
                        { "for": { "in": "groupBy" } },
                        { "for": { "in": "values" } },
                        { "for": { "in": "tooltips" } },
                        { "for": { "in": "permissions" } }
                    ],
                    "dataReductionAlgorithm": {
                        "window": { "count": 30000 }
                    }
                }
            }
        }
    ],
